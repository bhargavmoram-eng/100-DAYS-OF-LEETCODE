class Solution(object):
    def maxLength(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        def gcd(a, b):
            while b:
                a, b = b, a % b
            return a

        n = len(nums)
        max_len = 0
        
        for i in range(n):
            curr_prod = 1
            curr_gcd = 0
            curr_lcm = 1
            
            for j in range(i, n):
                curr_prod *= nums[j]
                curr_gcd = gcd(curr_gcd, nums[j])
                curr_lcm = (curr_lcm * nums[j]) // gcd(curr_lcm, nums[j])
                
                if curr_prod == curr_lcm * curr_gcd:
                    max_len = max(max_len, j - i + 1)
                
                if curr_prod > 25200:
                    break
                    
        return max_len
